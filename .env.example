# copy to .env - .env is already gitignored, never commit the real key
SARVAM_API_KEY=
DATABASE_URL=postgresql://audit:audit@localhost:55433/audit
# read-only role (sql/008_readonly_role.sql) -- LLM-written SQL (run_sql tool) uses this,
# never the superuser DATABASE_URL above
DATABASE_URL_READONLY=postgresql://audit_readonly:audit_readonly_ro@localhost:55433/audit
